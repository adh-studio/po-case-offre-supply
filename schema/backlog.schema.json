{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adh-studio.github.io/po-case-offre-supply/schema/backlog.schema.json",
  "title": "Backlog produit Data & IA : domaine Offre et Supply",
  "type": "object",
  "additionalProperties": false,
  "required": ["produit", "enseigne", "version", "cas_usage"],
  "properties": {
    "produit": { "type": "string", "minLength": 1 },
    "enseigne": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "cas_usage": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/cas_usage" }
    }
  },
  "$defs": {
    "cas_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titre", "categorie", "description", "rice", "valeur_metier", "dependances_data"],
      "properties": {
        "id": { "type": "string", "pattern": "^CU-[0-9]{2}$" },
        "titre": { "type": "string", "minLength": 10 },
        "categorie": { "enum": ["Analytics", "Automatisation", "IA"] },
        "description": { "type": "string", "minLength": 30 },
        "rice": { "$ref": "#/$defs/rice" },
        "valeur_metier": { "type": "string", "minLength": 30 },
        "dependances_data": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^dp_[a-z0-9_]+$" }
        },
        "user_story": { "type": "string", "pattern": "^US-[0-9]{3}$" }
      }
    },
    "rice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reach", "impact", "confidence", "effort", "score"],
      "properties": {
        "reach": { "type": "number", "exclusiveMinimum": 0 },
        "impact": { "enum": [0.25, 0.5, 1, 1.5, 2, 3] },
        "confidence": { "type": "number", "minimum": 0.5, "maximum": 1.0 },
        "effort": { "type": "number", "exclusiveMinimum": 0 },
        "score": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
